{
  "name": "flint",
  "version": "0.1.0",
  "private": true,
  "description": "Agents make private markets on Midnight (tBTC/tUSD on the NIGHTGATE offer board) and hedge every fill on Strike BTC-PERP, inside one owner-signed mandate.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "live": "node --env-file-if-exists=.env cli/live.mjs",
    "strike": "node --env-file-if-exists=.env cli/strike.mjs",
    "liquidity": "node --env-file-if-exists=.env cli/liquidity.mjs",
    "owner": "node --env-file-if-exists=.env cli/owner.mjs",
    "rogue": "node --env-file-if-exists=.env cli/rogue.mjs",
    "mock-feed": "node cli/mock-feed.mjs",
    "gateway": "node --env-file-if-exists=.env cli/gateway.mjs",
    "onboard": "node --env-file-if-exists=.env cli/onboard.mjs",
    "pay-demo": "node --env-file-if-exists=.env cli/pay-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@noble/hashes": "^1.8.0",
    "@odatano/contract-kit": "^0.1.0",
    "@odatano/contract-token-factory": "^0.1.0",
    "@odatano/nightgate-mcp": "^0.18.2",
    "@odatano/nightgate-tx": "^0.15.1",
    "@scure/base": "^2.4.0",
    "@x402/cardano": "^2.28.0",
    "@x402/fetch": "^2.28.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "$@midnight-ntwrk/onchain-runtime-v3"
  },
  "optionalDependencies": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
