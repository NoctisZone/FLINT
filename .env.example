# NIGHTGATE gateway key (oda_…). Every agent's Midnight wallet acts with it.
NIGHTGATE_KEY=
# Claude agents (MM Claude, the two citizens).
ANTHROPIC_API_KEY=

# Strike. Testnet unless STRIKE_API_URL names the mainnet host. One API wallet per agent: the 32-byte Ed25519
# seed as hex (`npm run strike -- keygen`), its public key registered on Strike for that agent's account.
# The CLI uses STRIKE_KEY, or STRIKE_KEY_<NAME> with `--key <NAME>`.
STRIKE_API_URL=https://api-v2-testnet.strikefinance.org
STRIKE_KEY=
STRIKE_KEY_MM_RULE=
STRIKE_KEY_MM_CLAUDE=
STRIKE_KEY_ROGUE=
# Only for wallets made through builder connect; 0-100 basis points of every fill.
STRIKE_BUILDER_FEE_BPS=
# Test settings over the shipped mandates: hedge deadline in seconds, Strike position cap in USD.
HEDGE_WITHIN_SEC=
MAX_POSITION_USD=

# Proof servers on THIS machine, comma-separated; a half reveals its coins to the proof server, so never a hosted one.
PROOF_SERVER_URL=http://localhost:6300

# Chain reads: the public preprod indexer and RPC are gone; point these at an indexer and node of your own
# (on the box: local; on a PC: through the SSH tunnel, see local_docs/infra.md).
INDEXER_HTTP_URL=http://localhost:8088/api/v4/graphql
INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
NODE_URL=ws://localhost:9944

# Attestations on Midnight: the AttestationVault address (64 hex) and its lineage; every ATTEST_EVERY_ROUNDS rounds a window is attested.
ATTESTATION_VAULT=
ATTESTATION_ARTIFACT=attestation-vault-32
ATTEST_EVERY_ROUNDS=10

# The owner: the Cardano preprod address every built-in mandate names; the wallet with that address signs in on the page.
OWNER_ADDRESS=
# Strike builder connect, for the agents' own accounts (cli/onboard.mjs and a new agent from the page).
STRIKE_BUILDER_CODE=
# A new agent from the page: what its owner pays. The set-up fee in test ADA (by mind) goes to X402_PAY_TO, else to the treasury address;
# the deposit into the agent's Strike account comes from the owner's wallet and is at least MIN_DEPOSIT_ADA.
SETUP_FEE_ADA=20
SETUP_FEE_CLAUDE_ADA=40
MIN_DEPOSIT_ADA=500
# x402 price of a tools key in lovelace (default 0 = free with the owner's session); the set-up fee by x402 is SETUP_FEE_ADA.
# PUBLIC_OWNER_URL is the /owner/ prefix as outsiders reach it.
X402_PRICE_KEY=0
PUBLIC_OWNER_URL=

# A deposit into a running agent from the page: at least this many test ADA (default 50).
MIN_TOPUP_ADA=50
# Markets closed for new agents, comma-separated (a Strike book nobody can hedge on); running agents keep theirs. Shown greyed out on the page.
MARKETS_OFF=
# Where set-up fees and x402 payments go; empty = the treasury address derived from the master seed.
X402_PAY_TO=
# The stand-in market maker on Strike testnet (npm run liquidity): its own API wallet key, the markets it quotes,
# the size a side in USD at the mark, the position cap in USD a market, spreads in basis points a side.
STRIKE_LIQUIDITY_KEY=
LIQUIDITY_SYMBOLS=BTC-USD,ADA-USD,SOL-USD
LIQUIDITY_SIZE_USD=800
LIQUIDITY_MAX_POSITION_USD=4000
LIQUIDITY_SPREAD_BPS=10
LIQUIDITY_REDUCE_BPS=5
# The sentence the feed shows for it (meta.strikeLiquidity); empty when the real book stands on the other side.
STRIKE_LIQUIDITY_NOTE=
# The owner's console headless (npm run owner): a 32-byte Ed25519 seed as hex; its address is what mandates name as owner.
OWNER_SEED_HEX=
OWNER_STAKE_SEED_HEX=
# Chain reads and submits through the ODATANO API when the key is set, Koios otherwise (KOIOS_URL overrides the preprod host).
ODATANO_ACCESS_KEY=
ODATANO_ACCESS_URL=
KOIOS_URL=
# Where quotes wait for their taker: server (the NIGHTGATE offer board) or gateway (inside this process).
MIDNIGHT_BOARD=server
# Badges on Midnight every this many rounds.
BADGES_EVERY_ROUNDS=30
# x402: the facilitator (facilitator/ runs one over the ODATANO API), the network, and the paying outside agent's wallet (cli/pay-demo.mjs).
X402_FACILITATOR_URL=
X402_FACILITATOR_KEY=
X402_NETWORK=cardano:preprod
BUYER_MNEMONIC=
# The tools endpoint as outsiders reach it (meta.tools.url).
PUBLIC_TOOLS_URL=
# The Claude maker: model and decisions a day; the citizens' take rate; the rule maker's quote size in USD.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_BUDGET=300
CITIZEN_RATE=0.3
MAKER_SIZE_USD=
